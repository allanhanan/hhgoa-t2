# Local development configuration for VoiceAgentRAG.
# Copy to .env and fill in real keys locally. Do not commit .env.

ENVIRONMENT=development

# LLM
VOR_LLM_PROVIDER=groq
VOR_LLM_MODEL=llama-3.3-70b-versatile
VOR_LLM_API_KEY=
VOR_LLM_BASE_URL=https://api.groq.com/openai/v1

# Embeddings: low-RAM local MiniLM, 384 dimensions.
VOR_EMBEDDING_PROVIDER=sentence-transformers
VOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
VOR_EMBEDDING_DIMENSION=384

# Qdrant: local test collection only.
VOR_VECTOR_STORE_PROVIDER=qdrant
VOR_QDRANT_URL=http://localhost:6333
VOR_QDRANT_API_KEY=
VOR_QDRANT_COLLECTION=msmarco_xi_test

# Voice
VOR_STT_PROVIDER=elevenlabs
VOR_TTS_PROVIDER=none
VOR_ELEVENLABS_API_KEY=
VOR_ELEVENLABS_STT_MODEL=scribe_v2
VOR_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOR_ELEVENLABS_MODEL=eleven_multilingual_v2
VOR_WHISPER_MODEL=base.en

# Development ingest limits.
INGESTION_LIMIT=100
ALLOW_SYNTHETIC_FALLBACK=false
