# API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Hardware Acceleration (auto | cuda | dml | cpu)
# auto: Uses CUDA/DirectML GPU if available, falls back to CPU
DEVICE=auto

# LLM Server (auto-started by entrypoint.sh)
LLAMA_CPP_URL=http://localhost:8081
